# Production environment inventory for Dokploy/server and GitHub Actions.
# Dokploy is the source of truth for runtime values. GitHub only mirrors the Docker build inputs.
# GitHub Actions secrets cannot be read back after creation, so recover missing values from Dokploy
# or the upstream provider and then re-save them in GitHub if a build needs them.

# Generate fixed-format values with:
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY => openssl rand -base64 32
# PAYLOAD_SECRET / PREVIEW_SECRET / SOURCE_API_KEY / CAL_WEBHOOK_SECRET => openssl rand -hex 32

# GitHub Docker build inputs
DATABASE_URI=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=
NEXT_PUBLIC_IS_LIVE=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_S3_HOSTNAME=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_UPLOAD_PREFIX=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
SENTRY_AUTH_TOKEN=

# Runtime only in Dokploy today
PREVIEW_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
RESEND_API_KEY=
UNSPLASH_ACCESS_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
RESEND_DEFAULT_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOKS_ENDPOINT_SECRET=
SOURCE_API_URL=
SOURCE_API_KEY=
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
REDWOOD_AUTOMATION_ENABLED=
REDWOOD_LOGIN_URL=
REDWOOD_USERNAME=
REDWOOD_PASSWORD=
REDWOOD_DONOR_SEARCH_URL=
REDWOOD_IMPORT_URL=
REDWOOD_ACCOUNT_NUMBER=
REDWOOD_ALLOWED_ACCOUNT_NUMBERS=
REDWOOD_DONOR_GROUP=
REDWOOD_WORKER_BATCH_LIMIT=
REDWOOD_WORKER_IDLE_SECONDS=
REDWOOD_SCHEDULE_HANDLER_CRON=
EMAIL_TEST_MODE=
EMAIL_TEST_ADDRESS=
NON_LIVE_EMAIL_BLOCKLIST=

# GitHub deployment secrets; not production app runtime or Docker build inputs
DOKPLOY_COMPOSE_DEPLOY_WEBHOOK_URL=
DOCKERHUB_TOKEN=
DOCKERHUB_USERNAME=
