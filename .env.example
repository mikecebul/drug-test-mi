# Used to encrypt JWT tokens
# Generate with: openssl rand -hex 24
PAYLOAD_SECRET=payload-secret-here
# Stable Server Action key (base64 AES key, shared across all instances/builds)
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Generate with: openssl rand -hex 16
PREVIEW_SECRET=preview-secret-here

# base url
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000

# Allow robots to index the site (optional)
NEXT_PUBLIC_IS_LIVE=false

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=google-maps-api-key

# Resend Email
RESEND_DEFAULT_EMAIL=dev@example.dev
RESEND_API_KEY=resend-key-here

# Email safety
# Non-live environments (NEXT_PUBLIC_IS_LIVE=false) redirect notification emails to EMAIL_TEST_ADDRESS.
# EMAIL_TEST_MODE=true forces the same redirect even if the live flag is enabled.
EMAIL_TEST_MODE=true
EMAIL_TEST_ADDRESS=mike@midrugtest.com
# Always removed from non-live notification recipient lists before redirecting.
NON_LIVE_EMAIL_BLOCKLIST=tom@midrugtest.com
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Playwright / Admin E2E
PAYLOAD_ADMIN_AUTOLOGIN_ENABLED=true
PAYLOAD_ADMIN_AUTOLOGIN_EMAIL=e2e.admin.autologin@example.com
PAYLOAD_ADMIN_AUTOLOGIN_PASSWORD=StrongPass123!
# Optional Playwright runner overrides:
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_WORKERS=1

#Turso DB
LOCAL_DATABASE_URL='file:./payload.db'
TURSO_DATABASE_URL=libsql://dbName-username.turso.io
TURSO_AUTH_TOKEN=turso-auth-token

# Mongo DB
DATABASE_URI=mongodb://localhost:27017/cvx-junior-golf

# S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
NEXT_PUBLIC_S3_HOSTNAME=

# Unsplash API
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=stripe-secret-key
STRIPE_WEBHOOKS_ENDPOINT_SECRET=stripe-webhook-secret

# SEED 
SOURCE_API_URL=http://localhost:3000
SOURCE_API_KEY=

# Glitchtip/Sentry
SENTRY_AUTH_TOKEN=

# Cal.com Webhook
# Prefer CAL_WEBHOOK_SECRET to match the Cal.com API skill. CALCOM_WEBHOOK_SECRET is still supported by the app for existing deployments.
CAL_WEBHOOK_SECRET=your-calcom-webhook-secret-here
# CALCOM_WEBHOOK_SECRET=your-calcom-webhook-secret-here
CAL_API_KEY=your-calcom-api-key-here
# Random testing. Cal.com supplies availability and the real appointment; Google Calendar stores anonymous holds.
RANDOM_TESTING_CALL_IN_PHONE=800-494-1250
RANDOM_TESTING_CHECK_IN_URL=https://drugtestcheck.com
# Optional explicit Cal.com schedule ID. When omitted, the default schedule is used.
RANDOM_TESTING_CALCOM_SCHEDULE_ID=840279
# Unpaid 10-minute cal.com/midrugtest/drug-test event used to replace today's hold.
RANDOM_TESTING_CALCOM_EVENT_TYPE_ID=3684719
# Share the target calendar with this service account using "Make changes and see all event details."
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
# Use either the escaped PEM value or the base64 value. Base64 is recommended for Dokploy.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY=
# Generate from the downloaded service-account JSON with:
# jq -r '.private_key | @base64' service-account-key.json
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
# Optional: only needed when using Google Workspace domain-wide delegation instead of calendar sharing.
GOOGLE_CALENDAR_IMPERSONATED_USER=
# Optional fallback when Cal.com does not return its host email.
GOOGLE_CALENDAR_ORGANIZER_EMAIL=mike@midrugtest.com
# Kill switch for Google Calendar writes and Cal.com booking creation. GET previews remain read-only.
RANDOM_TESTING_SCHEDULE_SYNC_ENABLED=false
# Payload cron expressions include seconds. Defaults are Monday 6:05 AM and daily 6:00 AM.
RANDOM_TESTING_UPCOMING_CRON=0 5 6 * * 1
RANDOM_TESTING_TODAY_CRON=0 0 6 * * *

# Redwood / ToxAccess automation
# Global execution flag. Keep false until the Redwood worker is deployed and credentials are configured.
REDWOOD_AUTOMATION_ENABLED=false
REDWOOD_USERNAME=
REDWOOD_PASSWORD=
REDWOOD_LOGIN_URL=https://toxaccess.redwoodtoxicology.com/Pages/Public/Login.aspx
REDWOOD_DONOR_SEARCH_URL=https://toxaccess.redwoodtoxicology.com/Pages/User/DonorSearch.aspx
REDWOOD_SCHEDULED_COLLECTIONS_URL=https://toxaccess.redwoodtoxicology.com/Pages/User/ScheduledCollections.aspx
REDWOOD_UPCOMING_COLLECTIONS_URL=https://toxaccess.redwoodtoxicology.com/Pages/User/UpcomingScheduleCollection.aspx
REDWOOD_IMPORT_URL=https://toxaccess.redwoodtoxicology.com/Pages/User/ImportDonors.aspx
REDWOOD_ACCOUNT_NUMBER=310974
# Include every ToxAccess account that should be searched for existing donors and permitted for mutations.
REDWOOD_ALLOWED_ACCOUNT_NUMBERS=310974,310872
# Optional fallback for the ImportDonors "Group" column when referral type does not map to Court, Employer, or Self.
REDWOOD_DONOR_GROUP=
# Worker tuning. The single long-lived worker handles schedules, drains queued work immediately, then polls while idle.
REDWOOD_WORKER_BATCH_LIMIT=3
# Maximum idle pickup delay. Keep this low for on-site donor registration.
REDWOOD_WORKER_POLL_MS=1000
# Worker healthcheck state shared by the worker process and its container probe.
REDWOOD_WORKER_HEARTBEAT_PATH=/tmp/redwood-worker-heartbeat
REDWOOD_WORKER_HEALTH_MAX_AGE_MS=120000
